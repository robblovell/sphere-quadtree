{
  "name": "spherequadtree",
  "version": "1.0.0",
  "description": "A persistent spherical quadtree reference implementation",
  "type": "module",
  "bin": {
    "spherequadtree": "./dist/cli.js",
    "sqt": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/cli.js",
    "dist/index.d.ts",
    "dist/index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types && rollup dist/types/index.d.ts --plugin dts --format es --file dist/index.d.ts --silent && esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --outdir=dist",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' '*.json' '*.js' '*.ts' README.md",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.2",
    "eslint": "9.17.0",
    "prettier": "^3.4.2",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "6.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "^2.1.9"
  }
}
