{
  "name": "spherequadtree",
  "version": "1.0.0",
  "description": "A persistent spherical quadtree reference implementation",
  "type": "module",
  "bin": {
    "spherequadtree": "./dist/cli.js",
    "sqt": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/cli.js",
    "dist/index.d.ts",
    "dist/index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types && rollup dist/types/index.d.ts --plugin dts --format es --file dist/index.d.ts --silent && esbuild src/index.ts src/cli.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' package.json package-lock.json tsconfig.json '*.js' '*.ts' README.md",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "prettier": "^3.4.2",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "6.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
